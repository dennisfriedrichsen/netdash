#!/bin/sh
F="$NETDASH_FIXTURES/${NETDASH_MOCK_FIXDIR:-$(echo "$NETDASH_MOCK_OS" | tr 'A-Z' 'a-z')}"
case "$*" in
  *-T*) # FreeBSD accepts -T; OpenBSD, NetBSD and macOS reject it
    if [ -f "$F/df-k-T-l.txt" ]; then exec cat "$F/df-k-T-l.txt"; fi
    echo "df: unknown option -- T" >&2; exit 1 ;;
esac
exec cat "$F/${NETDASH_MOCK_DF:-df-k-l}.txt"
