{
  "bind_host": "0.0.0.0",
  "bind_port": 8080,
  "db_path": "/var/lib/netdash/netdash.db",
  "ingest_token": "CHANGE-ME-shared-secret",
  "retention_hours": 24,
  "stale_after_seconds": 180,
  "patch_stale_hours": 48,
  "reachability": {
    "enabled": true,
    "checks": [
      "icmp",
      "tcp:22"
    ],
    "interval_seconds": 30,
    "timeout_seconds": 2,
    "failures_before_down": 2,
    "down_after_seconds": 900
  },
  "thresholds": {
    "cpu": {
      "warn": 80,
      "crit": 95,
      "sustain_seconds": 300
    },
    "mem": {
      "warn": 85,
      "crit": 95
    },
    "disk": {
      "warn": 85,
      "crit": 95
    },
    "zfs": {
      "scrub_max_age_days": 42,
      "smart_max_age_days": 35
    }
  },
  "truenas": {
    "enabled": false,
    "host": "truenas.example",
    "display_name": "truenas",
    "scheme": "https",
    "verify_tls": false,
    "api_key": "",
    "poll_seconds": 60,
    "patch_poll_seconds": 3600,
    "smart_poll_seconds": 3600
  },
  "hubitat": {
    "enabled": false,
    "host": "hubitat.example",
    "display_name": "hubitat",
    "scheme": "http",
    "mem_total_bytes": 2147483648,
    "poll_seconds": 60,
    "patch_poll_seconds": 3600
  },
  "unifi": {
    "enabled": false,
    "host": "10.0.0.1",
    "display_name": "gateway",
    "scheme": "https",
    "verify_tls": false,
    "api_key": "",
    "fleet": true,
    "poll_seconds": 60
  },
  "eol": {
    "enabled": true,
    "refresh_hours": 24,
    "warn_days": 30,
    "overrides": {}
  },
  "services": {
    "interval_seconds": 60,
    "timeout_seconds": 5,
    "failures_before_fail": 2,
    "checks": [
      {
        "kind": "home_assistant",
        "host": "hassium.example",
        "url": "http://10.0.0.42:8123",
        "enabled": false
      },
      {
        "kind": "plex",
        "host": "plex.example",
        "url": "http://10.0.0.43:32400",
        "enabled": false
      },
      {
        "kind": "transmission",
        "host": "jail.example",
        "url": "http://10.0.0.44:9091",
        "enabled": false
      },
      {
        "kind": "ipmi",
        "host": "truenas.example",
        "address": "10.0.0.45",
        "tls_fingerprint_sha256": "",
        "enabled": false
      }
    ]
  },
  "hosts": {
    "laptop.example": {
      "expect_up": false,
      "stale_after_seconds": 900
    },
    "hassium.example": {
      "address": "10.0.0.42"
    },
    "jail.example": {
      "parent": "truenas.example"
    }
  }
}
