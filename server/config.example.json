{
  "bind_host": "0.0.0.0",
  "bind_port": 8080,
  "db_path": "/var/lib/netdash/netdash.db",
  "ingest_token": "CHANGE-ME-shared-secret",
  "retention_hours": 24,
  "stale_after_seconds": 180,
  "thresholds": {
    "cpu":  { "warn": 80, "crit": 95 },
    "mem":  { "warn": 85, "crit": 95 },
    "disk": { "warn": 85, "crit": 95 }
  },
  "truenas": {
    "enabled": false,
    "host": "10.0.0.2",
    "display_name": "truenas-core",
    "scheme": "https",
    "verify_tls": false,
    "api_key": "",
    "poll_seconds": 60
  }
}
